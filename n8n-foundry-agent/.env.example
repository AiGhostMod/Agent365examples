# ==============================================================================
# Azure AI Foundry Configuration (used by n8n Azure OpenAI Chat Model node)
# ==============================================================================
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-project>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# ==============================================================================
# Azure Monitor / Application Insights (tracing destination)
# ==============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# ==============================================================================
# Microsoft Agent 365 SDK Configuration
# ==============================================================================
AGENT365_AGENT_ID=n8n-foundry-agent-001
AGENT365_AGENT_DISPLAY_NAME=n8n Foundry Agent
AGENT365_TENANT_ID=<your-tenant-id>
AGENT365_CLIENT_ID=<entra-app-client-id>
AGENT365_CLIENT_SECRET=<entra-app-client-secret>

# ==============================================================================
# n8n Configuration
# ==============================================================================
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=<generate-a-random-key>
WEBHOOK_URL=http://localhost:5678/

# ==============================================================================
# Agent365 Wrapper Server
# ==============================================================================
WRAPPER_PORT=8001
