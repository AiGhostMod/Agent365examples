# ==============================================================================
# Azure AI Foundry (fka Azure AI Studio) Configuration
# ==============================================================================
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-5.2
AZURE_AI_FOUNDRY_API_VERSION=2025-04-01-preview

# Azure Authentication (DefaultAzureCredential used by default)
# For service principal auth:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ==============================================================================
# Azure Monitor / Application Insights (tracing destination)
# ==============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# Set to "true" to log prompt/completion content in traces (off by default for privacy)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Set to "1" to also emit traces to console for local dev debugging
FOUNDRY_TRACE_DEBUG=

# ==============================================================================
# Microsoft Agent 365 SDK Configuration
# ==============================================================================
# Agent identity (Entra-backed agent ID from Agent 365 CLI / portal)
AGENT365_AGENT_ID=langgraph-foundry-agent-001
AGENT365_AGENT_DISPLAY_NAME=LangGraph Foundry Agent
AGENT365_TENANT_ID=<your-tenant-id>

# Agent 365 requires Entra ID app registration with Microsoft Graph delegated permissions.
# See: https://learn.microsoft.com/en-us/microsoft-agent-365/developer/
AGENT365_CLIENT_ID=<entra-app-client-id>
AGENT365_CLIENT_SECRET=<entra-app-client-secret>

# ==============================================================================
# Server
# ==============================================================================
HOST=0.0.0.0
PORT=8000
